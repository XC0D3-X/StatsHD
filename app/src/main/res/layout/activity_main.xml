<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- TOP HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="StatHD"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="PURE STATUS ENGINE"
                android:textColor="@color/emerald_light"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="Bypass aggressive WhatsApp Status compression • Hardware H.264 bitrate lock &amp; precision pixel scaling."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- STEP 1: VIDEO PICKER & TELEMETRY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. SOURCE MASTER VIDEO"
                android:textColor="@color/emerald_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="10dp"
                android:background="#06080C">

                <VideoView
                    android:id="@+id/videoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvEmptyPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="No video selected.\nTap the button below or Share any video directly from your Gallery to StatHD."
                    android:textAlignment="center"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSourceSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:text="Resolution: - | Size: - | Duration: -"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickVideo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="SELECT VIDEO FROM GALLERY"
                android:textColor="#04130D"
                android:textStyle="bold"
                app:backgroundTint="@color/emerald_primary"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- STEP 2: WHATSAPP STATUS HD PRESETS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. WHATSAPP STATUS OPTIMIZATION PRESET"
                android:textColor="@color/emerald_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Preset 1: Pure 720p HD -->
            <LinearLayout
                android:id="@+id/cardPreset720"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_preset_selected"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PURE 720p HD • SWEET SPOT (Recommended)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="720x1280 • Locked 2.2 Mbps H.264 • ~5MB/20s. Bypasses WhatsApp re-compression with maximum sharpness."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Preset 2: Ultra 1080p FHD -->
            <LinearLayout
                android:id="@+id/cardPreset1080"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_preset_unselected"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ULTRA 1080p FHD • MAX CLARITY"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="1080x1920 • Locked 3.2 Mbps H.264 • Ideal for shorter clips (15-30s) with fine text and details."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Preset 3: Long Status 60s -->
            <LinearLayout
                android:id="@+id/cardPreset60s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_preset_unselected"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LONG STATUS 60s • SIZE SAVER (&lt;12MB)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="720x1280 • Locked 1.5 Mbps H.264 • Keeps full 60-second status videos under ~11MB to avoid macroblocking."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- STEP 3: VISUAL & AUDIO TUNING -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. PURE STATUS ENGINE TUNING"
                android:textColor="@color/emerald_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchCrispBoost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="Crisp Micro-Contrast Boost (Edge Sharpening)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchHdrToneMap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Auto HDR-to-SDR Tone-Map (Fix Washed-Out Colors)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchMuteAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Remove Audio (100% Bitrate Quota for Video)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- STEP 4: EXECUTE & PROGRESS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOptimize"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="OPTIMIZE VIDEO FOR WHATSAPP HD"
            android:textColor="#04130D"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/emerald_light"
            app:cornerRadius="12dp" />

        <LinearLayout
            android:id="@+id/layoutProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvProgressStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Running Hardware H.264 Encoder... 0%"
                android:textColor="@color/emerald_light"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/emerald_primary" />
        </LinearLayout>

        <!-- STEP 5: OUTPUT RESULT & DIRECT WHATSAPP SHARE -->
        <LinearLayout
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_preset_selected"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ STATHD MASTER READY (WA COMPRESSION BYPASSED)"
                android:textColor="@color/emerald_light"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="New Size: - MB | Bitrate: - Mbps"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="SEND DIRECTLY TO WHATSAPP STATUS"
                android:textColor="#04130D"
                android:textStyle="bold"
                app:backgroundTint="@color/whatsapp_green"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveGallery"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="SAVE TO GALLERY (Movies/StatHD)"
                android:textColor="@color/emerald_light"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="@color/emerald_primary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
