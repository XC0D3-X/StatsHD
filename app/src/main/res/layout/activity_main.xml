<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- TOP HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="StatHD"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="PURE STATUS ENGINE v1.2"
                android:textColor="@color/emerald_light"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="Lossless Direct Stream Copy (Zero Re-Encode for &lt;=1280px) • H.264 High Profile CABAC • Gamer 90° Full-Screen Mode."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- STEP 1: VIDEO PICKER & TELEMETRY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. SOURCE MASTER VIDEO"
                android:textColor="@color/emerald_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="10dp"
                android:background="#06080C">

                <VideoView
                    android:id="@+id/videoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvEmptyPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="No video selected.\nTap the button below or Share any video directly from your Gallery to StatHD."
                    android:textAlignment="center"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSourceSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:text="Resolution: - | Size: - | Duration: -"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvResolutionGuardInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="Engine Mode: Waiting for video..."
                android:textColor="@color/emerald_light"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickVideo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="SELECT VIDEO FROM GALLERY"
                android:textColor="#04130D"
                android:textStyle="bold"
                app:backgroundTint="@color/emerald_primary"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- STEP 2: BUILT-IN STATUS CLIP TRIMMER & ENGINE MODE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. STATUS CLIP MODE (LOSSLESS STREAM COPY / HIGH PROFILE)"
                android:textColor="@color/emerald_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Preset 1: 30s Lossless / Ultra HD Highlight -->
            <LinearLayout
                android:id="@+id/cardPreset720"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_preset_selected"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30s LOSSLESS DIRECT CUT / ULTRA HD (Recommended)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Max 30s Clip • If source is &lt;=1280px (e.g. 1280x576), uses 100% LOSSLESS BIT-FOR-BIT STREAM COPY (0% pixel loss, identical to original!). If &gt;1280px, encodes at 3.2 Mbps H.264 High Profile."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Preset 2: 45s Lossless / High Clarity -->
            <LinearLayout
                android:id="@+id/cardPreset1080"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_preset_unselected"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45s LOSSLESS / HIGH CLARITY (&lt;10.5 MB CEILING)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Max 45s Clip • Uses 100% Lossless Stream Copy if slice is &lt;10.5 MB, or 1.9 Mbps H.264 High Profile CABAC."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Preset 3: 60s Balanced -->
            <LinearLayout
                android:id="@+id/cardPreset60s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_preset_unselected"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60s 1-MINUTE STATUS (1.45 Mbps High Profile)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Max 60s Clip • Note: Longer clips get lower bitrate per second due to WhatsApp's 11 MB cap. Use 30s mode for sharpest gaming graphics!"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Highlight Start Time Trimmer Slider -->
            <LinearLayout
                android:id="@+id/layoutTrimSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#0B0F17"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvTrimWindow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Clip Window: 0:00 ➔ 0:30 (Slide to pick highlight moment)"
                    android:textColor="@color/emerald_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekBarTrimStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/emerald_primary"
                    android:thumbTint="@color/emerald_light" />
            </LinearLayout>
        </LinearLayout>

        <!-- STEP 3: GAMER FULL-SCREEN & COLOR FIDELITY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. GAMER FULL-SCREEN &amp; COLOR FIDELITY"
                android:textColor="@color/emerald_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchRotateVertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:checked="false"
                android:text="Gamer Full-Screen Mode (Rotate 90° Vertical • 2.5x Bigger Pixels)"
                android:textColor="@color/emerald_light"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Tip: Horizontal games on a vertical phone screen only use 25% of the screen (324p). Turning ON Rotate 90° uses 100% of the vertical 1280px screen!"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchMuteAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Remove Audio (100% Bitrate Quota for Video)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchCrispBoost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Optional Micro-Contrast Boost (Keep OFF for 100% original colors)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchHdrToneMap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Force HDR-to-SDR Tone-Map (Only for 10-bit HDR clips)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- STEP 4: EXECUTE & PROGRESS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOptimize"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="OPTIMIZE VIDEO FOR WHATSAPP HD"
            android:textColor="#04130D"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/emerald_light"
            app:cornerRadius="12dp" />

        <LinearLayout
            android:id="@+id/layoutProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvProgressStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Running PureStatus Engine... 0%"
                android:textColor="@color/emerald_light"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/emerald_primary" />
        </LinearLayout>

        <!-- STEP 5: OUTPUT RESULT & DIRECT WHATSAPP SHARE -->
        <LinearLayout
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_preset_selected"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ STATHD v1.2 MASTER READY (WA BYPASS)"
                android:textColor="@color/emerald_light"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="New Size: - MB | Bitrate: - Mbps"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="SEND DIRECTLY TO WHATSAPP STATUS"
                android:textColor="#04130D"
                android:textStyle="bold"
                app:backgroundTint="@color/whatsapp_green"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveGallery"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="SAVE TO GALLERY (Movies/StatHD)"
                android:textColor="@color/emerald_light"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="@color/emerald_primary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
