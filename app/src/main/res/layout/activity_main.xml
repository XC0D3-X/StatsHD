<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- TOP HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="StatHD"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="WINK GPU ENGINE v1.4 BETA"
                android:textColor="@color/emerald_light"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="Wink-Style GPU Quality Restoration (Bilateral De-Block + CAS Edge Reconstruction) • Smart 1280px Guard • WhatsApp HD Bypass."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- STEP 1: VIDEO PICKER & TELEMETRY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. SOURCE MASTER VIDEO"
                android:textColor="@color/emerald_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="10dp"
                android:background="#06080C">

                <VideoView
                    android:id="@+id/videoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvEmptyPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="No video selected.\nTap the button below or Share any video directly from your Gallery to StatHD."
                    android:textAlignment="center"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSourceSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:text="Resolution: - | Size: - | Duration: -"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvResolutionGuardInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="Engine Mode: Waiting for video..."
                android:textColor="@color/emerald_light"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickVideo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="SELECT VIDEO FROM GALLERY"
                android:textColor="#04130D"
                android:textStyle="bold"
                app:backgroundTint="@color/emerald_primary"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- STEP 2: WINK GPU ULTRA-HD RESTORATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. WINK GPU ULTRA-HD QUALITY RESTORATION"
                android:textColor="@color/emerald_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchWinkRestore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:checked="true"
                android:text="✨ Wink Ultra-HD Restoration (De-Block + CAS Edge Sharpen)"
                android:textColor="@color/emerald_light"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Runs a 9-tap GPU shader on every frame: smooths blocky compression noise on flat areas (grass/skin) while reconstructing razor-sharp text &amp; hero outlines."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchWinkMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="🔥 Wink MAX Game/Anime Clarifier (Stronger Detail Pop)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- STEP 3: STATUS CLIP TRIMMER & BITRATE LOCK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. STATUS CLIP WINDOW &amp; BITRATE MODE (&lt;10.5 MB CEILING)"
                android:textColor="@color/emerald_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Preset 1: 30s Ultra HD -->
            <LinearLayout
                android:id="@+id/cardPreset720"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_preset_selected"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30s WINK ULTRA HD (Recommended • Maximum Detail)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Max 30s Clip • Locked 2.65 Mbps H.264 High-Profile CABAC (~9.9 MB) • 1280px Max Long-Side (1:1 Native if &lt;=1280px)."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Preset 2: 45s High Clarity -->
            <LinearLayout
                android:id="@+id/cardPreset1080"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_preset_unselected"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45s WINK HIGH CLARITY (&lt;10.5 MB CEILING)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Max 45s Clip • Locked 1.80 Mbps H.264 High-Profile CABAC (~10.2 MB)."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Preset 3: 60s Balanced -->
            <LinearLayout
                android:id="@+id/cardPreset60s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_preset_unselected"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60s 1-MINUTE STATUS (1.38 Mbps High-Profile)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Max 60s Clip • Note: Use 30s mode for fast-action gaming highlights to get 2x higher bitrate per second!"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Highlight Start Time Trimmer Slider -->
            <LinearLayout
                android:id="@+id/layoutTrimSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#0B0F17"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvTrimWindow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Clip Window: 0:00 ➔ 0:30 (Slide to pick highlight moment)"
                    android:textColor="@color/emerald_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekBarTrimStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/emerald_primary"
                    android:thumbTint="@color/emerald_light" />
            </LinearLayout>
        </LinearLayout>

        <!-- STEP 4: ORIENTATION & AUDIO TUNING -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. ORIENTATION &amp; AUDIO TUNING"
                android:textColor="@color/emerald_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchRotateVertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:checked="false"
                android:text="Gamer Full-Screen Mode (Rotate 90° Vertical • 2.5x Bigger Pixels)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchMuteAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Remove Audio (100% Bitrate Quota for Video)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchCrispBoost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Extra Deep Contrast (Keep OFF for natural shadow detail)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchHdrToneMap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Force HDR-to-SDR Tone-Map (Only for 10-bit HDR clips)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- STEP 5: EXECUTE & PROGRESS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOptimize"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="RESTORE &amp; OPTIMIZE VIDEO (WINK HD)"
            android:textColor="#04130D"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/emerald_light"
            app:cornerRadius="12dp" />

        <LinearLayout
            android:id="@+id/layoutProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvProgressStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Running Wink GPU Shader + H.264 High Profile... 0%"
                android:textColor="@color/emerald_light"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/emerald_primary" />
        </LinearLayout>

        <!-- STEP 6: OUTPUT RESULT & DIRECT WHATSAPP SHARE -->
        <LinearLayout
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_preset_selected"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ WINK GPU ULTRA-HD MASTER READY"
                android:textColor="@color/emerald_light"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="New Size: - MB | Bitrate: - Mbps"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareWhatsApp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="SEND DIRECTLY TO WHATSAPP STATUS"
                android:textColor="#04130D"
                android:textStyle="bold"
                app:backgroundTint="@color/whatsapp_green"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveGallery"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="SAVE TO GALLERY (Movies/StatHD)"
                android:textColor="@color/emerald_light"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="@color/emerald_primary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
